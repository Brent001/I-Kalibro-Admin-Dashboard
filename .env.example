# ==========================================================
# Example environment config
# Copy this file to .env and replace the placeholder values.
# ==========================================================

# DATABASE_URL:
# Get this from Neon dashboard > your project > Connect > Connection string
# Example: postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>/<db_name>?sslmode=require&channel_binding=require"
# Local Postgres example:
# DATABASE_URL="postgres://postgres:<password>@localhost:5432/<db_name>"

# JWT secrets:
# Generate strong random values with: openssl rand -base64 32
JWT_SECRET="<your_jwt_secret>"
JWT_REFRESH_SECRET="<your_jwt_refresh_secret>"

# Redis / Upstash:
# Get from Upstash dashboard > Database > REST API section
UPSTASH_REDIS_REST_URL="https://<your_upstash_redis_host>"
UPSTASH_REDIS_REST_TOKEN="<your_upstash_redis_rest_token>"

# Resend email API key:
# Get from Resend dashboard > API Keys
VITE_RESEND_API_KEY="<your_resend_api_key>"

# Cron secret:
# Use a random secret string, for example: openssl rand -hex 32
CRON_SECRET="<your_cron_secret>"

# Encryption key:
# Generate a random 32-byte value for encryption
VITE_ENCRYPTION_KEY="<your_encryption_key>"

# Backblaze B2 config:
# Get from Backblaze B2 > Application Keys and your bucket settings
# The VITE_ prefix is required here because the app reads these in the browser.
VITE_BACKBLAZE_KEY_ID="<your_backblaze_key_id>"
VITE_BACKBLAZE_APPLICATION_KEY="<your_backblaze_application_key>"
VITE_BACKBLAZE_BUCKET_NAME="<your_backblaze_bucket_name>"
VITE_BACKBLAZE_BUCKET_ID="<your_backblaze_bucket_id>"
VITE_BACKBLAZE_REGION="<your_backblaze_region>"

# Google Books API key:
# Get from Google Cloud Console > APIs & Services > Credentials > API key
# Optional: improves quota, but lookup works without it.
GOOGLE_BOOKS_API_KEY=""
